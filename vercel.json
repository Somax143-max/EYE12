{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, POST, OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type, Authorization" }
      ]
    },
    {
      "source": "/(.*)\\.(png|jpg|jpeg|webp|svg|ico|js|css)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://drishti-ai-backend.onrender.com/api/:path*"
    },
    {
      "source": "/sample_images/:path*",
      "destination": "/frontend/sample_images/:path*"
    },
    {
      "source": "/:file((?!frontend).+\\.png)",
      "destination": "/frontend/:file"
    },
    {
      "source": "/style.css",
      "destination": "/frontend/style.css"
    },
    {
      "source": "/portal_engine.js",
      "destination": "/frontend/portal_engine.js"
    },
    {
      "source": "/",
      "destination": "/frontend/index.html"
    }
  ]
}
